# POS Grocery V2 Environment Configuration
# Copy this file to .env and update the values as needed

# Application Environment
NODE_ENV=development
PORT=8250

# Database Configuration
DB_PATH=./data/pos.db
SKIP_MIGRATIONS=false

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8250

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8103,http://127.0.0.1:8103

# Logging Configuration
LOG_LEVEL=info

# Performance Configuration
FAST_DEV=false
SKIP_HARDWARE_CHECKS=false

# Rate Limiting Configuration
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
RATE_LIMIT_WINDOW_MS=60000

# Body Size Limits
JSON_LIMIT_MB=2
URL_ENCODED_LIMIT_MB=1

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_MAX_AGE=86400000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@pos-grocery.com

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Print Configuration
PRINT_ENABLED=true
PRINT_DEFAULT_PRINTER=default
PRINT_PAPER_SIZE=A4
PRINT_ORIENTATION=portrait

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=104857600

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_TIMEOUT=30000

# WebSocket Configuration
WS_ENABLED=true
WS_PORT=8251
WS_HEARTBEAT_INTERVAL=30000

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60000

# Development Configuration
DEV_HOT_RELOAD=true
DEV_OPEN_BROWSER=true
DEV_ANALYZE_BUNDLE=false

# Testing Configuration
TEST_DB_PATH=./data/test.db
TEST_TIMEOUT=10000
TEST_COVERAGE_THRESHOLD=80

# Production Configuration
PROD_COMPRESSION=true
PROD_MINIFY=true
PROD_SOURCE_MAPS=false
PROD_ANALYTICS_ID=

# Feature Flags
FEATURE_OFFLINE_MODE=true
FEATURE_PWA=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=false
FEATURE_DEBUG_MODE=false

# External Services
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_RETRIES=3
EXTERNAL_API_RETRY_DELAY=1000

# Database Performance
DB_CONNECTION_LIMIT=10
DB_QUERY_TIMEOUT=30000
DB_ENABLE_WAL=true
DB_SYNCHRONOUS=NORMAL

# Memory Configuration
MAX_MEMORY_USAGE=512MB
GC_THRESHOLD=100MB
HEAP_SNAPSHOT_INTERVAL=3600000

# Network Configuration
KEEP_ALIVE_TIMEOUT=5000
HEADERS_TIMEOUT=40000
REQUEST_TIMEOUT=30000

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# Load Balancer Configuration
BEHIND_PROXY=false
TRUST_PROXY=false
PROXY_HEADERS=X-Forwarded-For,X-Forwarded-Proto,X-Forwarded-Host

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,si,ta
TIMEZONE=Asia/Colombo
CURRENCY=LKR
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss

# Business Configuration
BUSINESS_NAME=POS Grocery Store
BUSINESS_ADDRESS=123 Main Street, Colombo, Sri Lanka
BUSINESS_PHONE=+94-11-123-4567
BUSINESS_EMAIL=info@pos-grocery.com
BUSINESS_TAX_ID=123456789
BUSINESS_REGISTRATION=ABC123456

# Receipt Configuration
RECEIPT_HEADER=POS GROCERY STORE
RECEIPT_FOOTER=Thank you for shopping with us!
RECEIPT_SHOW_TAX=true
RECEIPT_SHOW_DISCOUNT=true
RECEIPT_SHOW_PAYMENT_METHOD=true

# Inventory Configuration
INVENTORY_TRACKING=true
INVENTORY_ALERT_THRESHOLD=10
INVENTORY_COST_METHOD=FIFO
INVENTORY_AUTO_REORDER=false

# Sales Configuration
SALES_TAX_RATE=15
SALES_DISCOUNT_LIMIT=50
SALES_RETURN_PERIOD=7
SALES_RECEIPT_REQUIRED=true

# User Configuration
USER_SESSION_TIMEOUT=3600000
USER_MAX_LOGIN_ATTEMPTS=5
USER_LOCKOUT_DURATION=900000
USER_PASSWORD_EXPIRY=90

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=info
AUDIT_INCLUDE_REQUEST_BODY=false

# Notification Configuration
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL=true
NOTIFICATION_SMS=false
NOTIFICATION_PUSH=true

# Integration Configuration
INTEGRATION_ACCOUNTING=false
INTEGRATION_PAYMENT_GATEWAY=false
INTEGRATION_INVENTORY_SYSTEM=false
INTEGRATION_CRM=false