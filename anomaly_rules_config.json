{
  "anomaly_detection_rules": {
    "version": "1.0.0",
    "description": "Configuration for anomaly detection rules in the POS system",
    "rules": [
      {
        "id": "sales_spike",
        "name": "Sales Volume Spike",
        "description": "Detects sudden spikes in sales volume (>3x rolling 7-day average)",
        "enabled": true,
        "severity": "high",
        "threshold": 3.0,
        "window_days": 7,
        "category": "sales_volume",
        "alert_channels": ["slack", "email"],
        "auto_resolve": false,
        "cooldown_hours": 24
      },
      {
        "id": "zero_margin",
        "name": "Zero/Negative Margin Sale",
        "description": "Detects sales with zero or negative profit margins",
        "enabled": true,
        "severity": "critical",
        "threshold": 0.0,
        "window_days": 1,
        "category": "margin",
        "alert_channels": ["slack", "email", "telegram"],
        "auto_resolve": false,
        "cooldown_hours": 0
      },
      {
        "id": "frequent_voids",
        "name": "Frequent Voids",
        "description": "Detects cashiers with unusually high void frequency (>20% of transactions)",
        "enabled": true,
        "severity": "medium",
        "threshold": 0.2,
        "window_days": 7,
        "category": "voids",
        "alert_channels": ["slack", "email"],
        "auto_resolve": true,
        "cooldown_hours": 168
      },
      {
        "id": "excessive_discounts",
        "name": "Excessive Discounts",
        "description": "Detects transactions with unusually high discount percentages (>50%)",
        "enabled": true,
        "severity": "medium",
        "threshold": 0.5,
        "window_days": 1,
        "category": "discounts",
        "alert_channels": ["slack", "email"],
        "auto_resolve": false,
        "cooldown_hours": 24
      },
      {
        "id": "off_hours_sales",
        "name": "Off-Hours Sales",
        "description": "Detects sales outside normal business hours (before 6 AM or after 10 PM)",
        "enabled": true,
        "severity": "low",
        "threshold": 0,
        "window_days": 1,
        "category": "timing",
        "alert_channels": ["slack"],
        "auto_resolve": true,
        "cooldown_hours": 24
      },
      {
        "id": "large_transaction",
        "name": "Large Transaction",
        "description": "Detects unusually large transactions (>LKR 50,000)",
        "enabled": true,
        "severity": "medium",
        "threshold": 50000,
        "window_days": 1,
        "category": "sales_volume",
        "alert_channels": ["slack", "email"],
        "auto_resolve": false,
        "cooldown_hours": 0
      }
    ],
    "global_settings": {
      "detection_interval_hours": 1,
      "retention_days": 90,
      "max_anomalies_per_rule": 1000,
      "notification_cooldown_minutes": 30,
      "escalation_enabled": true,
      "escalation_threshold_hours": 24
    },
    "alert_channels": {
      "slack": {
        "enabled": true,
        "webhook_url": "${ALERTS_SLACK_WEBHOOK_URL}",
        "channel": "#pos-anomalies",
        "mention_users": ["@admin", "@manager"]
      },
      "email": {
        "enabled": true,
        "smtp_host": "${ALERTS_EMAIL_SMTP_HOST}",
        "smtp_port": 587,
        "from_email": "${ALERTS_EMAIL_FROM}",
        "to_emails": ["${ALERTS_EMAIL_TO}"],
        "subject_template": "POS Anomaly Alert: {rule_name} - {severity}"
      },
      "telegram": {
        "enabled": true,
        "bot_token": "${ALERTS_TELEGRAM_BOT_TOKEN}",
        "chat_id": "${ALERTS_TELEGRAM_CHAT_ID}",
        "parse_mode": "Markdown"
      }
    },
    "severity_levels": {
      "critical": {
        "color": "#dc2626",
        "priority": 1,
        "requires_immediate_action": true,
        "escalation_time_minutes": 15
      },
      "high": {
        "color": "#ea580c",
        "priority": 2,
        "requires_immediate_action": false,
        "escalation_time_minutes": 60
      },
      "medium": {
        "color": "#d97706",
        "priority": 3,
        "requires_immediate_action": false,
        "escalation_time_minutes": 240
      },
      "low": {
        "color": "#2563eb",
        "priority": 4,
        "requires_immediate_action": false,
        "escalation_time_minutes": 1440
      }
    },
    "categories": {
      "sales_volume": {
        "description": "Detects unusual patterns in sales volume and transaction amounts",
        "icon": "trending-up",
        "color": "#7c3aed"
      },
      "margin": {
        "description": "Detects margin-related issues and profit concerns",
        "icon": "dollar-sign",
        "color": "#059669"
      },
      "voids": {
        "description": "Detects unusual void patterns and potential fraud",
        "icon": "x-circle",
        "color": "#dc2626"
      },
      "discounts": {
        "description": "Detects excessive discount usage and potential abuse",
        "icon": "percent",
        "color": "#2563eb"
      },
      "timing": {
        "description": "Detects unusual timing patterns in transactions",
        "icon": "clock",
        "color": "#ea580c"
      }
    }
  },
  "environment_variables": {
    "ALERTS_SLACK_WEBHOOK_URL": "Slack webhook URL for anomaly alerts",
    "ALERTS_EMAIL_SMTP_HOST": "SMTP host for email alerts",
    "ALERTS_EMAIL_SMTP_PORT": "SMTP port for email alerts",
    "ALERTS_EMAIL_SMTP_USER": "SMTP username for email alerts",
    "ALERTS_EMAIL_SMTP_PASS": "SMTP password for email alerts",
    "ALERTS_EMAIL_FROM": "From email address for alerts",
    "ALERTS_EMAIL_TO": "Comma-separated list of recipient emails",
    "ALERTS_TELEGRAM_BOT_TOKEN": "Telegram bot token for alerts",
    "ALERTS_TELEGRAM_CHAT_ID": "Telegram chat ID for alerts"
  },
  "usage_examples": {
    "api_endpoints": {
      "get_anomalies": "GET /api/reports/anomalies?start=2024-01-01&end=2024-01-31&severity=critical",
      "get_summary": "GET /api/reports/anomalies/summary?start=2024-01-01&end=2024-01-31",
      "get_rules": "GET /api/reports/anomalies/rules",
      "update_rule": "PUT /api/reports/anomalies/rules/sales_spike",
      "detect_anomalies": "POST /api/reports/anomalies/detect",
      "export_csv": "GET /api/reports/anomalies/export?start=2024-01-01&end=2024-01-31"
    },
    "query_parameters": {
      "start": "Start date in YYYY-MM-DD format",
      "end": "End date in YYYY-MM-DD format",
      "severity": "Filter by severity: low, medium, high, critical",
      "category": "Filter by category: sales_volume, margin, voids, discounts, timing",
      "rule_id": "Filter by specific rule ID",
      "limit": "Number of results to return (1-1000)",
      "offset": "Number of results to skip for pagination"
    }
  },
  "sample_responses": {
    "anomalies_response": {
      "ok": true,
      "data": {
        "anomalies": [
          {
            "id": "sales_spike_2024-01-15",
            "rule_id": "sales_spike",
            "rule_name": "Sales Volume Spike",
            "severity": "high",
            "description": "Sales spike detected: 3.5x normal volume",
            "detected_at": "2024-01-15T00:00:00Z",
            "value": 125000,
            "threshold": 35714,
            "deviation": 3.5,
            "context": {},
            "metadata": {
              "rolling_average": 35714,
              "transaction_count": 45,
              "previous_days": 7
            }
          }
        ],
        "summary": {
          "total_anomalies": 1,
          "by_severity": {
            "critical": 0,
            "high": 1,
            "medium": 0,
            "low": 0
          },
          "by_category": {
            "sales_volume": 1,
            "margin": 0,
            "voids": 0,
            "discounts": 0,
            "timing": 0
          },
          "by_rule": {
            "sales_spike": 1
          },
          "time_range": {
            "start": "2024-01-15T00:00:00Z",
            "end": "2024-01-15T00:00:00Z"
          }
        },
        "pagination": {
          "total": 1,
          "limit": 100,
          "offset": 0,
          "has_more": false
        },
        "filters": {
          "start_date": "2024-01-01",
          "end_date": "2024-01-31",
          "severity": null,
          "category": null,
          "rule_id": null
        },
        "generated_at": "2024-01-15T08:30:45.123Z"
      }
    }
  }
}










