# Frontend Environment Configuration for Production
# Copy this file to your production server as .env.production and update the values

# API Configuration
VITE_API_BASE_URL=http://your-server-ip/api
# For HTTPS deployment:
# VITE_API_BASE_URL=https://your-domain.com/api

# Application Configuration
VITE_APP_NAME=POS Grocery System
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Point of Sale System for Grocery Stores

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Print Service Configuration
VITE_PRINT_SERVICE_URL=http://your-server-ip:3001
VITE_PRINT_ENABLED=true

# Scale Service Configuration
VITE_SCALE_SERVICE_URL=http://your-server-ip:3002
VITE_SCALE_ENABLED=true

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_CACHE_ENABLED=true

# Development/Testing (set to false in production)
VITE_DEBUG_MODE=false
VITE_VERBOSE_LOGGING=false
VITE_MOCK_SERVICES=false











