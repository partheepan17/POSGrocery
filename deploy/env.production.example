# Production Environment Configuration
# Copy this file to your production server as .env and update the values

# Application
NODE_ENV=production
PORT=8250
APP_NAME=POS Grocery System
APP_VERSION=1.0.0

# Database
DB_PATH=/var/www/pos-grocery/data/pos-grocery.db
DB_BACKUP_PATH=/var/www/pos-grocery/backups
DB_BACKUP_RETENTION_DAYS=30

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGINS=http://your-domain.com,https://your-domain.com,http://your-server-ip

# Logging
LOG_LEVEL=warn
LOG_FILE_PATH=/var/log/pos-grocery
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Redis (Optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_PRODUCTS=60
CACHE_TTL_CATEGORIES=300
CACHE_TTL_SUPPLIERS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_RPM=200
RATE_LIMIT_BURST=50

# File Upload
MAX_FILE_SIZE=10MB
UPLOAD_PATH=/var/www/pos-grocery/uploads

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key
COOKIE_SECRET=your-cookie-secret-key

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
PERFORMANCE_MONITORING=true

# Development/Testing (set to false in production)
FAST_DEV=false
DEBUG_MODE=false
VERBOSE_LOGGING=false











