<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Service Configuration for POS Grocery System -->
<service>
  <id>pos-grocery-backend</id>
  <name>POS Grocery Backend Service</name>
  <description>Node.js backend service for POS Grocery System</description>
  <executable>node</executable>
  <arguments>dist/index.js</arguments>
  <workingdirectory>C:\pos-grocery\server</workingdirectory>
  <logmode>rotate</logmode>
  <logpath>C:\pos-grocery\logs</logpath>
  <log>pos-grocery-service.log</log>
  <errlog>pos-grocery-service-error.log</errlog>
  <outlog>pos-grocery-service-out.log</outlog>
  <logrotate>true</logrotate>
  <maxlogfiles>10</maxlogfiles>
  <maxlogsize>10485760</maxlogsize>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="none"/>
  <resetfailure>1 hour</resetfailure>
  <restart>1 hour</restart>
  <waithint>5000</waithint>
  <sleeptime>5000</sleeptime>
  <interact>false</interact>
  <env name="NODE_ENV" value="production"/>
  <env name="PORT" value="8250"/>
  <env name="JWT_SECRET" value="your-super-secret-jwt-key-change-this-in-production"/>
  <env name="JWT_EXPIRES_IN" value="24h"/>
  <env name="DB_PATH" value="C:\pos-grocery\data\pos-grocery.db"/>
  <env name="LOG_LEVEL" value="info"/>
  <env name="CORS_ORIGINS" value="http://localhost,http://127.0.0.1"/>
  <env name="REDIS_URL" value="redis://localhost:6379"/>
  <env name="CACHE_TTL_PRODUCTS" value="60"/>
  <env name="RATE_LIMIT_WINDOW_MS" value="900000"/>
  <env name="RATE_LIMIT_RPM" value="200"/>
  <env name="RATE_LIMIT_BURST" value="50"/>
</service>











