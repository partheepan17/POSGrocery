{
  "name": "pos-grocery-v2",
  "version": "1.0.0",
  "description": "Point of Sale Grocery Management System",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:all": "concurrently -k -n server,client -c green,blue \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec tsx server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "build:client": "vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run && npm run test:api-contracts",
    "test:unit": "vitest run --coverage",
    "test:api-contracts": "vitest run tests/api/contracts.test.ts --config tests/api/contracts.config.ts",
    "test:api": "vitest run tests/api",
    "test:e2e": "echo \"E2E disabled\"",
    "test:all": "npm run test:unit && npm run test:api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed-database.js",
    "integrity": "tsx scripts/integrity.ts",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed": "tsx scripts/seed-database.js",
    "db:reset": "rm -f *.db && npm run db:migrate && npm run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "playwright:install": "playwright install",
    "playwright:report": "playwright show-report",
    "qa:full": "node scripts/qa-full.js",
    "release:notes": "node scripts/release-notes.js",
    "version:bump": "node scripts/version-bump.js",
    "release:check": "node scripts/release-check.js",
    "docker:build": "docker build -t pos-grocery .",
    "docker:run": "docker run -p 3002:3002 pos-grocery",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/multer": "^2.0.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.2.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dexie": "^4.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.294.0",
    "multer": "^2.0.2",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^16.1.0",
    "react-router-dom": "^6.20.1",
    "recharts": "^3.3.0",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.6",
    "uuid": "^9.0.1",
    "web-vitals": "^5.1.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^8.0.3",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.2.0",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "pos",
    "grocery",
    "management",
    "point-of-sale",
    "inventory",
    "sales"
  ],
  "author": "POS Grocery Team",
  "license": "MIT"
}
